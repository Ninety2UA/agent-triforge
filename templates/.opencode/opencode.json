{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "openrouter": {
      "models": {
        "z-ai/glm-5.3": {}
      }
    }
  },
  "permission": {
    "bash": {
      "*": "allow",
      "rm -rf*": "deny",
      "rm -fr*": "deny",
      "rm -Rf*": "deny",
      "rm -fR*": "deny",
      "rm -r *": "deny",
      "rm -R *": "deny",
      "git push*": "deny",
      "git -c * push*": "deny",
      "git -C * push*": "deny",
      "sudo*": "deny",
      "command sudo*": "deny",
      "doas *": "deny"
    }
  }
}
