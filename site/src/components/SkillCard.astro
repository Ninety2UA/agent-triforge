---
// One skill card in the approved catalog design: the group (and "lead" for a lead workflow), the name
// linking to the skill's page, a one-line summary and an optional second line. The catalog, the home
// page's featured skills and a skill page's related skills use it. With `filter` the card carries what
// the catalog filter matches on (skill-filter.mjs): its group key and label and its lower-case text.
import { badgeVariants } from '@/components/ui/badge';
import { inlineHtml } from './skill-html.mjs';
import { matchText } from './skill-filter.mjs';

interface Props {
  name: string;
  group: { key: string; label: string };
  lead: boolean;
  /** Markdown on one line: `code` spans render */
  summary: string;
  /** a second, quieter line, Markdown like the summary */
  use?: string;
  /** heading level of the name: 2 when the cards sit under the page's h1 */
  level?: 2 | 3;
  /** mark the card for the catalog filter */
  filter?: boolean;
}
const { name, group, lead, summary, use, level = 3, filter = false } = Astro.props;
const Name = level === 2 ? 'h2' : 'h3';
const text = filter ? matchText(name, group.label, lead ? 'lead workflow' : 'portable skill', summary, use ?? '') : undefined;
---
<li class="card" data-skill-card={filter ? '' : undefined} data-group={filter ? group.key : undefined} data-group-label={filter ? group.label : undefined} data-text={text}>
  <div class="meta">
    <span class={badgeVariants({ variant: 'secondary' })}>{group.label}</span>
    {lead && <span class={badgeVariants()}>lead</span>}
  </div>
  <Name><a href={`/skills/${name}/`}><code class="sk-nm">{name}</code></a></Name>
  <p set:html={inlineHtml(summary)} />
  {use && <p class="use" set:html={inlineHtml(use)} />}
</li>

<style>
  /* a long name breaks after one of its hyphens instead of running out of a phone-width card */
  .sk-nm { white-space: normal; }
</style>
