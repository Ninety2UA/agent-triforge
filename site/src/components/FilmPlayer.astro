---
// The film on its print sheet. It plays once on its own when half visible (never under reduced motion);
// a line of dots shows and sets the position, and the chapters are labelled buttons, so the film's
// outline reads without the video and a chapter press plays from there. Chapters come from
// public/media/film-chapters.json and the length and frame size from film.mp4 itself (media.mjs).
import { IC } from './icons';
import { clock, filmChapters, mp4Facts, versioned } from '@/lib/media.mjs';

interface Props {
  /** what the film shows, in plain words: the text alternative */
  label: string;
}
const { label } = Astro.props;
const { chapters, duration } = filmChapters();
const { width, height } = mp4Facts('/media/film.mp4');
---
<figure class="fig film" id="film-player" data-vfig data-film data-duration={duration.toFixed(2)}>
  <div class="film-sheet">
    <div class="vid" style={`aspect-ratio:${width}/${height}`}>
      <img class="vf-poster" src={versioned('/media/film.webp')} srcset={`${versioned('/media/film-960.webp')} 960w, ${versioned('/media/film.webp')} 1600w`} sizes="(max-width: 1240px) 94vw, 1180px" loading="lazy" decoding="async" width={width} height={height} alt="" />
      <video muted playsinline preload="none" controls width={width} height={height} aria-label={label}><source src={versioned('/media/film.mp4')} type="video/mp4" /></video>
      <button class="vf-big" type="button" data-label="the film" aria-label="Play the film"><Fragment set:html={IC.play} /><span>Play</span></button>
    </div>
    <div class="film-bar">
      <div class="film-dots" role="slider" tabindex="0" aria-label="Position in the film" aria-valuemin="0" aria-valuemax={Math.floor(duration)} aria-valuenow="0" aria-valuetext={`0:00 of ${clock(duration)}`}></div>
      <span class="film-time">0:00 / {clock(duration)}</span>
    </div>
    <ol class="chapters" aria-label="Chapters">{chapters.map((c) => <li><button type="button" data-t={c.start}>{c.label}<span>{clock(c.start)}</span></button></li>)}</ol>
  </div>
</figure>
