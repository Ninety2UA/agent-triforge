---
// The closing field: the install command beside the loop that opens the README (Fig. 5). The markdown
// that embeds it in another README is in the media kit (src/dev/kit.astro), not on the site.
import InstallTabs from '../InstallTabs.astro';
import VideoFigure from '../VideoFigure.astro';
import { buttonVariants } from '@/components/ui/button';
import { IC } from '../icons';
import { INSTALL_HREF } from '@/data/nav';
import { GH } from '@/data/content';
import { heroTabs } from '@/data/home';
---
<section id="start" class="closing" aria-labelledby="start-h" data-rv-group>
  <div class="wrap">
    <div class="close-grid">
      <div class="close-in" data-rv>
        <h2 id="start-h">Run your first sprint</h2>
        <p class="lede">Install the plugin, start Claude Code or Codex in your project, run <code>/at-setup</code>, then <code>/at-ship &lt;goal&gt;</code>.</p>
        <InstallTabs id="close-lead" tabs={heroTabs} label="Which CLI leads" class="close-tabs" />
        <div class="cta-row"><a class={buttonVariants()} href={INSTALL_HREF} data-lead-href={INSTALL_HREF}>Install</a><a class={buttonVariants({ variant: 'outline' })} href={GH}><Fragment set:html={IC.github} />Star on GitHub</a></div>
      </div>
      <div class="readme" data-rv>
        <VideoFigure n={5} name="readme-hero" short="the Agent Triforge loop" class="readme-fig"
          label="Loop: the Agent Triforge mark and name, with the line that one agent leads, the others build, review and test, and nothing merges until a different agent has checked it."
          caption="Nothing merges until a different agent has checked it" />
      </div>
    </div>
  </div>
</section>
