---
// The footer is the site map: every section and every docs, guide and tutorial page, so without
// JavaScript (where the phone menu is a link here) every page is reachable. The install copy control
// and the version close the page.
import Mark from './Mark.astro';
import CodeBlock from './CodeBlock.astro';
import { NAV } from '@/data/nav';
import { GH, INSTALL } from '@/data/content';

const columns = [
  {
    title: 'Agent Triforge',
    links: [
      ...NAV.filter((n) => ['Skills', 'Roster', 'Sprint', 'Changelog'].includes(n.label)).map((n) => ({ label: n.label, href: n.href })),
      { label: 'Personas', href: '/skills/personas/' },
    ],
  },
  {
    title: 'Docs',
    links: [
      { label: 'Getting started', href: '/docs/getting-started/' },
      { label: 'How it works', href: '/docs/how-it-works/' },
      { label: 'Workflows', href: '/docs/workflows/' },
      { label: 'Project layout', href: '/docs/project-layout/' },
      { label: 'Portable skills', href: '/docs/portable-skills/' },
      { label: 'Compatibility', href: '/docs/compatibility/' },
      { label: 'Upgrading', href: '/docs/upgrading/' },
      { label: 'FAQ', href: '/docs/faq/' },
    ],
  },
  {
    title: 'Guides',
    links: [
      { label: 'Leases and cross-review', href: '/guides/leases/' },
      { label: 'Unattended runs', href: '/guides/unattended-runs/' },
      { label: 'Team builds', href: '/guides/team-builds/' },
      { label: 'Models and effort', href: '/guides/models-and-effort/' },
      { label: 'Data egress', href: '/guides/data-egress/' },
    ],
  },
  {
    title: 'Tutorials',
    links: [
      { label: 'Your first sprint', href: '/tutorials/first-sprint/' },
      { label: 'A supervised sprint', href: '/tutorials/supervised-sprint/' },
      { label: 'An unattended run', href: '/tutorials/unattended-run/' },
    ],
  },
  {
    title: 'Install',
    links: [
      { label: 'Claude Code leads', href: '/docs/getting-started/#claude-code' },
      { label: 'Codex leads', href: '/docs/getting-started/#codex' },
      { label: 'Skills only: Devin, Pi', href: '/docs/getting-started/#skills-only' },
      { label: 'GitHub', href: GH },
      { label: 'License', href: `${GH}/blob/main/LICENSE` },
    ],
  },
];
---
<footer class="ftr">
  <div class="wrap">
    <div class="ftr-top">
      <div class="ftr-brand"><Mark class="ftr-mark" title="Agent Triforge" /></div>
      <nav id="site-map" class="ftr-map" aria-label="Site map">
        {columns.map((c) => (
          <div class="ftr-col">
            <p class="fh">{c.title}</p>
            <ul>{c.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
          </div>
        ))}
      </nav>
    </div>
    <div class="ftr-bot">
      <div><CodeBlock lines={INSTALL.claude} label="Copy the Claude Code install commands" /></div>
      <small>MIT license. Version 4.1.1, released 2026-10-13. Made by Ninety2UA.</small>
    </div>
  </div>
</footer>
