---
// Every page: metadata, the self-hosted fonts, the header, the page in <main>, the footer. Pages
// ship no framework JavaScript on load; islands hydrate on first use (client:interaction).
import { OG_IMAGE_ALT } from '@/lib/site.mjs';
import { Font } from 'astro:assets';
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { THEME_INIT } from '@/scripts/theme';

interface Props {
  /** unique per page */
  title: string;
  /** unique per page */
  description: string;
  /** absolute URL; defaults to this page's URL on the site. false for a page with no address of its own (404) */
  canonical?: string | false;
  /** index the whole <main> for search under this section; pages that mark their own body (DocsLayout) leave it out */
  search?: { section: string; weight?: number; title?: string };
}
const { title, description, canonical, search } = Astro.props;
const canonicalURL = canonical === false ? undefined : (canonical ?? new URL(Astro.url.pathname, Astro.site).href);
// One social image for every page (public/brand/og.png).
const ogImage = new URL('/brand/og.png', Astro.site).href;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {canonicalURL && <link rel="canonical" href={canonicalURL} />}
  <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#0b0d13" media="(prefers-color-scheme: dark)" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Agent Triforge" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  {canonicalURL && <meta property="og:url" content={canonicalURL} />}
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={OG_IMAGE_ALT} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="twitter:image:alt" content={OG_IMAGE_ALT} />
  <link rel="icon" href="/brand/favicon.svg" type="image/svg+xml" />
  <script is:inline set:html={THEME_INIT} />
  <Font cssVariable="--font-familjen" preload />
  <Font cssVariable="--font-sometype" />
  <Font cssVariable="--font-doto" />
  {/* Without JavaScript tabs cannot switch, so every panel shows under its own name; the controls that
      would do nothing (tab lists, copy, theme, search, filter chips, video play) are hidden. */}
  <noscript><style is:inline>[role=tabpanel][hidden]{display:block!important}[role=tabpanel]+[role=tabpanel]{margin-top:20px}.tp-name{display:block!important;font-weight:600;margin:0 0 8px}[data-tabs] [role=tablist],.press [role=tablist],.copy,[data-theme-toggle],[data-open-search],.chips,.film-bar,.bench-ctl{display:none!important}</style></noscript>
</head>
<body>
  <Header />
  <main id="main" data-pagefind-body={search ? '' : undefined} data-pagefind-filter={search ? `section:${search.section}` : undefined} data-pagefind-weight={search?.weight} data-pagefind-meta={search?.title ? `title:${search.title}` : undefined}><slot /></main>
  <Footer />
  <div id="live" class="sr" aria-live="polite"></div>
  <script>
    import { initThemeToggle } from '@/scripts/theme';
    import { initTabs } from '@/scripts/tabs';
    import { initCopy } from '@/scripts/copy';
    initThemeToggle();
    initTabs();
    initCopy();
    // the video player loads only on pages that show a figure
    if (document.querySelector('[data-vfig]')) import('@/scripts/video').then((m) => m.initVideos());
  </script>
  <script>import '@/components/search/loader';</script>
</body>
</html>
