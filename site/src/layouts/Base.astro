---
// Every page: metadata, the self-hosted fonts, the header, the page in <main>, the footer. Pages
// ship no framework JavaScript on load; islands hydrate on first use (client:interaction).
import { Font } from 'astro:assets';
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { THEME_INIT } from '@/scripts/theme';
import { LEAD_SKILLS, PORTABLE, NAV } from '@/data/content';

interface Props {
  /** unique per page */
  title: string;
  /** unique per page */
  description: string;
  /** absolute URL; defaults to this page's URL on the site. false for a page with no address of its own (404) */
  canonical?: string | false;
}
const { title, description, canonical } = Astro.props;
const canonicalURL = canonical === false ? undefined : (canonical ?? new URL(Astro.url.pathname, Astro.site).href);
// One social image for every page (public/brand/og.png).
const ogImage = new URL('/brand/og.png', Astro.site).href;
const ogAlt = 'Agent Triforge: three streams of dots joining one blue line, and the name.';
const search = [
  ...LEAD_SKILLS.map((s) => ({ title: s, kind: 'Lead workflows', href: `/skills/${s}/` })),
  ...PORTABLE.map((s) => ({ title: s, kind: 'Portable skills', href: `/skills/${s}/` })),
  ...NAV.map((n) => ({ title: n.label, kind: 'Pages', href: n.href })),
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {canonicalURL && <link rel="canonical" href={canonicalURL} />}
  <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#0b0d13" media="(prefers-color-scheme: dark)" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Agent Triforge" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  {canonicalURL && <meta property="og:url" content={canonicalURL} />}
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={ogAlt} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="twitter:image:alt" content={ogAlt} />
  <link rel="icon" href="/brand/favicon.svg" type="image/svg+xml" />
  <script is:inline set:html={THEME_INIT} />
  <Font cssVariable="--font-familjen" preload />
  <Font cssVariable="--font-sometype" />
  <Font cssVariable="--font-doto" />
</head>
<body>
  <Header />
  <main id="main"><slot /></main>
  <Footer />
  <script type="application/json" id="search-data" set:html={JSON.stringify(search)}></script>
  <div id="live" class="sr" aria-live="polite"></div>
  <script>
    import { initThemeToggle } from '@/scripts/theme';
    initThemeToggle();
  </script>
  <script>import '@/components/search/loader';</script>
  <script>import '@/scripts/home.js';</script>
</body>
</html>
